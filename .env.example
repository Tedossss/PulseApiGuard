# Used by Docker Compose. Generate a value with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters
SESSION_COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
FRONTEND_BIND_PORT=3000

# Telegram alerts. Keep TELEGRAM_BOT_TOKEN only in the untracked .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=PulseApiGuard_bot
