{
  "name": "pulseguard-api",
  "version": "1.0.0",
  "description": "PulseGuard API monitoring service",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --import tsx --test test/unit.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.3",
    "rate-limit-redis": "^6.0.0"
  },
  "main": "dist/app.js",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
